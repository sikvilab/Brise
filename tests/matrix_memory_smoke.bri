// Matrix and managed-memory smoke tests
// All matrix indexes are zero-based; new matrix cells start at 0.

Matrix:create(A, 2, 2)
Matrix:set(A, 0, 0, 1)
Matrix:set(A, 0, 1, 2)
Matrix:set(A, 1, 0, 3)
Matrix:set(A, 1, 1, 4)

assert: mrows("A") == 2
assert: mcols("A") == 2
assert: mget("A", 0, 0) == 1
assert: mget("A", 1, 0) == 3
assert: mexists("A")

Matrix:identity(I, 2)
Matrix:multiply(P, A, I)
assert: mget("P", 0, 1) == 2
assert: mget("P", 1, 0) == 3

Matrix:add(S, A, I)
assert: mget("S", 0, 0) == 2
assert: mget("S", 1, 1) == 5

Matrix:subtract(D, S, I)
assert: mget("D", 1, 0) == 3

Matrix:scale(T, A, 2)
assert: mget("T", 0, 1) == 4
Matrix:transpose(X, A)
assert: mget("X", 0, 1) == 3
assert: mget("X", 1, 0) == 2

Matrix:det(A, determinant)
assert: determinant == -2
assert: mdet("A") == -2

Matrix:inverse(inv, A)
Matrix:multiply(check, A, inv)
assert: abs(mget("check", 0, 0) - 1) < 1e-10
assert: abs(mget("check", 0, 1)) < 1e-10
assert: abs(mget("check", 1, 0)) < 1e-10
assert: abs(mget("check", 1, 1) - 1) < 1e-10

// Replacing a named allocation is safe, including in-place matrix operations.
Matrix:scale(A, A, 0.5)
assert: mget("A", 0, 1) == 1

Memory:alloc(work, 4)
assert: mem_size("work") == 4
Memory:set(work, 0, 11)
Memory:set(work, 3, 3.5)
assert: mem_get("work", 0) == 11
assert: mem_get("work", 3) == 3.5
Memory:fill(work, 2.5)
assert: mem_get("work", 1) == 2.5

free:work
assert: not mem_exists("work")
free:A
assert: not mexists("A")

say:"Matrix and managed-memory tests passed."
