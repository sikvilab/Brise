// Brise v0.5.0 smoke tests
set:name = "Brise"
assert: len(name) == 5
assert: upper("brise") == "BRISE"
assert: lower("HELLO") == "hello"
assert: trim("  ok  ") == "ok"
assert: contains("language", "guage")
assert: starts_with("Brise", "Bri")
assert: ends_with("Brise", "ise")
assert: type(42) == "number"
assert: abs(-5) == 5
assert: floor(3.9) == 3
assert: ceil(3.1) == 4
assert: round(3.5) == 4
assert: sqrt(81) == 9
assert: min(3, 8) == 3
assert: max(3, 8) == 8
assert: pow(2, 4) == 16
assert: assert_eq("same", "same")
assert: (2 < 3) and (3 < 4)
assert: (2 > 3) or (3 == 3)
assert: not (2 > 3)

set:counter = 0
while: counter < 4 (calc:counter = counter + 1)
assert: counter == 4

set:score = 90
if: score >= 80 and score <= 100 (set:result = "pass") else: (set:result = "fail")
assert: result == "pass"

say:"Brise smoke tests passed."

assert: 1.25e2 == 125
assert: abs(sin(pi / 2) - 1) < 1e-12
assert: abs(cos(0) - 1) < 1e-12
assert: abs(log(e) - 1) < 1e-12
assert: log10(100) == 2
assert: log2(8) == 3
assert: abs(cbrt(27) - 3) < 1e-12
assert: trunc(-3.8) == -3
assert: sign(-8) == -1
assert: factorial(5) == 120
assert: gcd(54, 24) == 6
assert: lcm(6, 8) == 24
assert: hypot(3, 4) == 5
assert: clamp(12, 0, 10) == 10
assert: lerp(10, 20, 0.25) == 12.5
assert: mod(7.5, 2) == 1.5
assert: is_prime(97)
assert: not is_prime(100)
assert: round_to(3.14159, 2) == 3.14
assert: abs(deg_to_rad(180) - pi) < 1e-12
assert: abs(rad_to_deg(pi) - 180) < 1e-12
